%% =====================================================================
%% Risk Quantification Methodology (RQM) Data Model — NSI-Minimal ERD
%% Iceberg v3 tables in namespace rqm.inventory. Apache Sedona is the query engine.
%% -
%% buildings  : one row per NSI structure; every NSI parquet column maps 1:1.
%% geometries : first-class multi-geometry attach (ADR-geometry preserved).
%%              Point for role='point', Polygon/MultiPolygon for role='footprint'.
%%              NSI load creates one point row per building; alternate
%%              footprint sources (MSBF, USAS) land as additional rows.
%% -
%% inventory_versions : version registry. Each version_name is also an Iceberg
%%                      tag on buildings + geometries (ADR-versioning).
%% inventory_changes  : per-building change log of each version vs. its parent.
%% -
%% The previous 35-table hybrid ERD is preserved at diagrams/rqm-erd-full.mmd.
%% Deferred domains (uncertainty, hazard, DDF, loss realizations, exports,
%% provenance, valid-time history) and their re-entry points are documented
%% in docs/decisions/ADR-nsi-minimal.md.
%% =====================================================================
erDiagram

  buildings {
    bigint      building_id PK "= fd_id"
    bigint      fd_id
    varchar     bid
    varchar     usastrucid
    varchar     ftprntid
    varchar     ftprntsrc
    varchar     source
    varchar     occtype
    varchar     st_damcat
    varchar     bldgtype
    smallint    num_story
    double      sqft
    double      ftprntsqft
    real        bldheight
    smallint    med_yr_blt
    varchar     found_type
    real        found_ht
    double      val_struct
    double      val_cont
    double      val_vehic
    double      ornl_low
    double      ornl_med
    double      ornl_hgh
    real        resunits
    real        novehprob
    real        vehperunit
    real        pop2amu65
    real        pop2amo65
    real        pop2pmu65
    real        pop2pmo65
    real        u65disable
    real        o65disable
    real        students
    varchar     firmzone
    varchar     zone_sub
    real        static_bfe
    real        ground_elv
    real        grnd_elv_m
    real        pctlowclr
    real        fullrep
    real        depindex
    real        creprcnt
    real        crerank
    varchar     cbfips
    double      x
    double      y
    timestamp   ingested_at
  }

  geometries {
    bigint      geometry_id PK
    bigint      building_id FK
    varchar     role
    varchar     purpose
    boolean     is_selected_for_export
    varchar     alt_group_key
    varchar     source_ref
    varchar     crs
    geometry    geom
    timestamp   ingested_at
  }

  inventory_versions {
    varchar     version_name PK "= Iceberg tag"
    varchar     parent_version FK
    varchar     merged_version FK
    varchar     branch
    varchar     kind
    varchar     source_uri
    varchar     source_sha256
    varchar     editor
    varchar     reason
    bigint      buildings_snapshot_id
    bigint      geometries_snapshot_id
    bigint      n_buildings
    bigint      n_added
    bigint      n_removed
    bigint      n_changed
    timestamp   created_at
  }

  inventory_changes {
    varchar     version_name PK,FK
    bigint      building_id PK,FK
    varchar     change_kind
    varchar[]   changed_columns
  }

  buildings ||--o{ geometries : "has 1..N representations"
  inventory_versions ||--o{ inventory_changes : "records changes vs. parent"
  buildings ||--o{ inventory_changes : "changed in"
  inventory_versions |o--o{ inventory_versions : "parent / merged"
  inventory_versions ||..|{ buildings : "tags a snapshot of"
  inventory_versions ||..|{ geometries : "tags a snapshot of"
